<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Algorithms.GUI.Models"
        xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:models="clr-namespace:Algorithms.GUI.Models"
        x:Class="Algorithms.GUI.Views.MainWindow"
        x:CompileBindings="False"
        Title="Бенчмарк Алгоритмов" Width="1380" Height="900"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="Full"
        CanResize="True"
        Background="{DynamicResource AppWindowBackground}"
        Foreground="{DynamicResource AppText}">

    <!-- Цвета берутся из Themes/Palette.axaml (тёмная и светлая темы) -->

    <Window.Styles>
        <!-- Карточка -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Общие кнопки -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Главная кнопка: цвета через сеттеры, а не Style.Resources (те видны всем кнопкам окна) -->
        <Style Selector="Button.primary">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundPointerOver}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundDisabled}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundDisabled}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Опасная кнопка -->
        <Style Selector="Button.danger">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorder}"/>
        </Style>

        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundPointerOver}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundPointerOver}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderPointerOver}"/>
        </Style>

        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundPointerOver}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderPressed}"/>
        </Style>

        <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundDisabled}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundDisabled}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderDisabled}"/>
        </Style>

        <!-- Маленькие кнопки масштаба -->
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Текст -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource AppProgressTrack}"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="392, *">

        <!-- ЛЕВАЯ ПАНЕЛЬ: НАСТРОЙКИ -->
        <Border Grid.Column="0" Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0" Padding="12">
            <Grid RowDefinitions="*, Auto">
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="6" MaxHeight="48" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="6" MaxHeight="48" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="6" MaxHeight="48" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="8" MaxHeight="48" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Настройки бенчмарка" Classes="title"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" Name="ThemeToggle"
                                          OnContent="Светлая" OffContent="Тёмная"
                                          ToolTip.Tip="Тема оформления"
                                          IsCheckedChanged="ThemeToggle_IsCheckedChanged" />
                        </Grid>

                        <!-- 1. Настройка Range данных -->
                        <Border Grid.Row="2" Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Входные данные для сортировки" Classes="section" />

                                <RadioButton Name="RangeDataRadio" Content="По диапазону (Start, End, Step)"
                                             IsChecked="True" />
                                <StackPanel IsEnabled="{Binding #RangeDataRadio.IsChecked}" Orientation="Horizontal"
                                            Spacing="6" Margin="20,0,0,4">
                                    <TextBox Name="StartValBox" PlaceholderText="0" Text="0" Width="90" />
                                    <TextBox Name="EndValBox" PlaceholderText="1000" Text="1000" Width="90" />
                                    <TextBox Name="StepValBox" PlaceholderText="10" Text="10" Width="90" />
                                </StackPanel>

                                <RadioButton Name="RandomDataRadio" Content="Случайные значения" />
                                <StackPanel IsEnabled="{Binding #RandomDataRadio.IsChecked}" Margin="20,0,0,0">
                                    <TextBox Name="CountValBox" PlaceholderText="2000" Text="2000" Width="280"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Выбор алгоритмов -->
                        <Border Grid.Row="4" Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Алгоритмы для запуска" Classes="section" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Выбрать все" Click="SelectAll_Click" Width="135"
                                            HorizontalContentAlignment="Center" />
                                    <Button Content="Снять все" Click="DeselectAll_Click" Width="135"
                                            HorizontalContentAlignment="Center" />
                                </StackPanel>

                                <ItemsControl Name="AlgorithmsList" Margin="0,5,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AlgorithmTaskItem">
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                      Margin="4,0,10,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Матрицы (Часть II) -->
                        <Border Grid.Row="6" Classes="card">
                            <StackPanel Spacing="6">
                                <CheckBox Name="RunMatrixCheckBox" Content="Умножение матриц (n×m)" IsChecked="True"
                                          Foreground="{DynamicResource AppText}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="N max" Classes="caption" />
                                        <TextBox Name="MatrixNMaxBox" Text="200" Width="80" />
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="M max" Classes="caption" />
                                        <TextBox Name="MatrixMMaxBox" Text="200" Width="80" />
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Шаг" Classes="caption" />
                                        <TextBox Name="MatrixStepBox" Text="10" Width="80" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Управление запуском и отображением -->
                        <StackPanel Grid.Row="8" Spacing="8">
                            <!-- Кнопки Запуска и Отмены -->
                            <Grid ColumnDefinitions="*, 10, Auto">
                                <Button Name="RunButton" Grid.Column="0" Content="Запустить вычисления"
                                        Click="RunButton_Click" Classes="primary"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        FontSize="15" Height="42" />

                                <Button Name="CancelButton" Grid.Column="2" Content="Отменить" Click="CancelButton_Click"
                                        Classes="danger"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        FontSize="15" Height="42" Width="120"
                                        IsEnabled="False" />
                            </Grid>

                            <!-- Панель прогресса (полоска + текст) -->
                            <StackPanel Name="ProgressPanel" IsVisible="False" Spacing="6">
                                <ProgressBar Name="ProgressIndicator" Minimum="0" Maximum="100" Value="0" Height="6" />
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <TextBlock Name="ProgressPercentText" Grid.Column="0" Text="0%" Classes="muted"
                                               FontSize="12" />
                                    <TextBlock Name="EtaText" Grid.Column="2" Text="Осталось: ~00:00" Classes="muted"
                                               FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Name="StatusText" Text="Ожидание запуска..." Classes="muted"
                                       TextWrapping="Wrap" />

                            <CheckBox Name="ShowApproxCheckBox" Content="Показывать теоретическую аппроксимацию"
                                      IsChecked="True" Foreground="{DynamicResource AppTextSecondary}" Click="ShowApprox_Click" />

                            <CheckBox Name="CombinedChartCheckBox" Content="Сравнить алгоритмы на одном графике"
                                      IsChecked="False" Foreground="{DynamicResource AppTextSecondary}" Click="ShowApprox_Click" />

                            <CheckBox Name="UseCacheCheckBox" Content="Использовать кэш (БД)" IsChecked="True"
                                      Foreground="{DynamicResource AppTextSecondary}" />
                            <Button Name="CompareHistoryButton" Content="Сравнить историю из БД"
                                    Click="CompareHistoryButton_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>

                    </Grid>
                </ScrollViewer>

                <!-- ССЫЛКА НА РЕПОЗИТОРИЙ (левый нижний угол) -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,10,0,0">
                    <Button Name="GitHubLinkButton" Click="GitHubLink_Click" HorizontalAlignment="Left"
                            ToolTip.Tip="https://github.com/0xddi/Algorithms_Lab1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AppAccent}"
                                  Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                            <TextBlock Text="0xddi/Algorithms_Lab1" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ: ГРАФИКИ -->
        <Grid Grid.Column="1">
            <!-- Пустое состояние: видно, пока нет ни одного графика -->
            <StackPanel Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" MaxWidth="360">
                <Path Data="{StaticResource IconChart}" Width="44" Height="44" Stretch="Uniform"
                      Stroke="{DynamicResource AppTextMuted}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" />
                <TextBlock Text="Графиков пока нет" Classes="section" FontSize="16"
                           HorizontalAlignment="Center" />
                <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Выберите алгоритмы слева и нажмите «Запустить вычисления» — здесь появятся графики времени работы и их теоретическая аппроксимация." />
            </StackPanel>

            <ScrollViewer Margin="12,12,0,12" Padding="0,0,12,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">

                    <!-- 1. Матрицы (3D поверхности) -->
                    <StackPanel Name="MatrixPanelHost" Orientation="Vertical" Spacing="12" />

                    <!-- 2. Область 2D графиков -->
                    <StackPanel Name="PlotsPanel" Orientation="Vertical" Spacing="12" />

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
