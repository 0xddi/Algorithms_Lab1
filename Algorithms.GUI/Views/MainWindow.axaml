<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Algorithms.GUI.Views.MainWindow"
        Title="Бенчмарк Алгоритмов" Width="600" Height="200">
    
    <Grid RowDefinitions="Auto,*">
        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="10">
            <Button Name="RunButton" Content="Запустить вычисления" Click="RunButton_Click"/>
            <ProgressBar Name="ProgressIndicator" IsIndeterminate="True" IsVisible="False"
                         Width="150" VerticalAlignment="Center"/>
            <TextBlock Name="StatusText" Text="Ожидание запуска..." VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>