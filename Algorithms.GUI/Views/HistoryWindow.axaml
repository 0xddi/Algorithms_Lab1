<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Algorithms.GUI.Models"
        x:Class="Algorithms.GUI.Views.HistoryWindow"
        x:CompileBindings="False"
        Title="Управление историей (Кэш БД)" Width="500" Height="600"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="#1E1E1E"
        Foreground="#D4D4D4">

    <Window.Resources>
        <Color x:Key="SystemAccentColor">#3794FF</Color>

        <!-- Кнопки -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#333337"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3E3E42"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#45454A"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3E3E42"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5A5A5F"/>

        <!-- Элементы списка -->
        <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#2A2D2E"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#094771"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#0B5A8F"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="#0B5A8F"/>
        <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#0B5A8F"/>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPointerOver" Color="#D4D4D4"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- Опасное действие -->
        <Style Selector="Button.danger">
            <Style.Resources>
                <SolidColorBrush x:Key="ButtonBackground" Color="#3A2323"/>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4A2B2B"/>
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#5A3333"/>
                <SolidColorBrush x:Key="ButtonForeground" Color="#F48771"/>
                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFA898"/>
                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFA898"/>
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#5A3333"/>
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#8A4A4A"/>
            </Style.Resources>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="Сохраненные сессии" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,12" Foreground="#D4D4D4"/>

        <!-- Обязательно Name="HistoryListBox" или x:Name="HistoryListBox" -->
        <ListBox Grid.Row="1" x:Name="HistoryListBox" SelectionMode="Multiple"
                 Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
                 CornerRadius="12" Padding="6">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:HistorySession">
                    <StackPanel Margin="4,6" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#5AA9FF" FontSize="14"/>
                        <TextBlock Text="{Binding AlgorithmsSummary}" FontSize="12" Foreground="#9D9D9D" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Загрузить для отображения (одна сессия)" Click="MenuLoadSingle_Click"/>
                    <MenuItem Header="Загрузить для сравнения (выбранные)" Click="MenuLoadCompare_Click"/>
                    <MenuItem Header="Сравнить с уже загруженными данными" Click="MenuCompareWithLoaded_Click"/>
                    <Separator/>
                    <MenuItem Header="Удалить выбранные данные" Click="MenuDelete_Click" Foreground="#F48771"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <Button Grid.Row="2" Content="Очистить всю базу данных" Click="ClearDbButton_Click"
                Classes="danger" Margin="0,16,0,0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40"/>
    </Grid>
</Window>
