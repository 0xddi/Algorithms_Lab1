<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Algorithms.GUI.Models"
        x:Class="Algorithms.GUI.Views.HistoryWindow"
        x:CompileBindings="False"
        Title="Управление историей (Кэш БД)" Width="500" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}"
        Foreground="{DynamicResource AppText}">

    <!-- Цвета берутся из Themes/Palette.axaml (тёмная и светлая темы) -->

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- Опасная кнопка -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorder}"/>
        </Style>

        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundPointerOver}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundPointerOver}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderPointerOver}"/>
        </Style>

        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundPointerOver}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderPressed}"/>
        </Style>

        <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundDisabled}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundDisabled}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderDisabled}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="Сохраненные сессии" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,12" Foreground="{DynamicResource AppText}"/>

        <!-- Обязательно Name="HistoryListBox" или x:Name="HistoryListBox" -->
        <ListBox Grid.Row="1" x:Name="HistoryListBox" SelectionMode="Multiple"
                 Background="{DynamicResource AppPanelBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                 CornerRadius="12" Padding="6">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:HistorySession">
                    <StackPanel Margin="4,6" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource AppLink}" FontSize="14"/>
                        <TextBlock Text="{Binding AlgorithmsSummary}" FontSize="12" Foreground="{DynamicResource AppTextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Загрузить для отображения (одна сессия)" Click="MenuLoadSingle_Click"/>
                    <MenuItem Header="Загрузить для сравнения (выбранные)" Click="MenuLoadCompare_Click"/>
                    <MenuItem Header="Сравнить с уже загруженными данными" Click="MenuCompareWithLoaded_Click"/>
                    <Separator/>
                    <MenuItem Header="Удалить выбранные данные" Click="MenuDelete_Click" Foreground="{DynamicResource AppDanger}"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <Button Grid.Row="2" Content="Очистить всю базу данных" Click="ClearDbButton_Click"
                Classes="danger" Margin="0,16,0,0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40"/>
    </Grid>
</Window>
