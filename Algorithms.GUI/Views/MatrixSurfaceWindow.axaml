<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Algorithms.GUI.Views.MatrixSurfaceControl">
    <Grid ColumnDefinitions="*,Auto">
        <!-- Поворот: правая кнопка мыши, сдвиг: левая, масштаб: колесо или панель карточки -->
        <Border Grid.Column="0" Background="{DynamicResource AppWindowBackground}" CornerRadius="8" ClipToBounds="True">
            <Canvas Name="DrawCanvas" Background="Transparent" ClipToBounds="True"
                    PointerWheelChanged="DrawCanvas_PointerWheelChanged"
                    PointerPressed="DrawCanvas_PointerPressed"
                    PointerMoved="DrawCanvas_PointerMoved"
                    PointerReleased="DrawCanvas_PointerReleased"/>
        </Border>

        <!-- Легенда Heatmap (для одиночного запуска) -->
        <StackPanel Name="HeatmapLegendPanel" Grid.Column="1" Width="50" Margin="4" Spacing="2">
            <TextBlock Name="LegendUnitText" Text="T,мс" Foreground="{DynamicResource AppTextSecondary}" FontSize="9" HorizontalAlignment="Center"/>
            <TextBlock Name="LegendMaxText" Text="0" Foreground="{DynamicResource AppTextSecondary}" FontSize="9" HorizontalAlignment="Center"/>
            <Border Width="14" Height="160" CornerRadius="3" HorizontalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#FF0000"/>
                        <GradientStop Offset="0.5" Color="#00FF00"/>
                        <GradientStop Offset="1" Color="#0000FF"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock Name="LegendMinText" Text="0" Foreground="{DynamicResource AppTextSecondary}" FontSize="9" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Легенда Серий (для сравнения из истории) -->
        <StackPanel Name="SeriesLegendPanel" Grid.Column="1" IsVisible="False" Margin="8,4" Spacing="4"
                    VerticalAlignment="Top">
            <TextBlock Text="Сессии" Foreground="{DynamicResource AppText}" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <ItemsControl Name="SeriesLegendItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">

                            <!-- Кнопка-глазик -->
                            <ToggleButton Classes="icon-toggle" IsChecked="{Binding IsVisible}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Показать или скрыть серию"
                                          Click="LegendEyeButton_Click">
                                <Panel>
                                    <Path Data="{StaticResource IconEye}"
                                          IsVisible="{Binding $parent[ToggleButton].IsChecked}"/>
                                    <Path Data="{StaticResource IconEyeOff}"
                                          IsVisible="{Binding !$parent[ToggleButton].IsChecked}"/>
                                </Panel>
                            </ToggleButton>
                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AppText}" FontSize="11"
                                       VerticalAlignment="Center" MaxWidth="100" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
