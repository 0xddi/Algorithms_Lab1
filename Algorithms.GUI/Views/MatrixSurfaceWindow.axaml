<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Algorithms.GUI.Views.MatrixSurfaceControl">
    <Grid ColumnDefinitions="*,Auto">
        <!-- Поворот: правая кнопка мыши, сдвиг: левая, масштаб: колесо или панель карточки -->
        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" ClipToBounds="True">
            <Canvas Name="DrawCanvas" Background="Transparent" ClipToBounds="True"
                    PointerWheelChanged="DrawCanvas_PointerWheelChanged"
                    PointerPressed="DrawCanvas_PointerPressed"
                    PointerMoved="DrawCanvas_PointerMoved"
                    PointerReleased="DrawCanvas_PointerReleased"/>
        </Border>

        <!-- Легенда Heatmap (для одиночного запуска) -->
        <StackPanel Name="HeatmapLegendPanel" Grid.Column="1" Width="50" Margin="4" Spacing="2">
            <TextBlock Text="T,мс" Foreground="#CCCCCC" FontSize="9" HorizontalAlignment="Center"/>
            <TextBlock Name="LegendMaxText" Text="0" Foreground="#CCCCCC" FontSize="9" HorizontalAlignment="Center"/>
            <Border Width="14" Height="160" CornerRadius="3" HorizontalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#FF0000"/>
                        <GradientStop Offset="0.5" Color="#00FF00"/>
                        <GradientStop Offset="1" Color="#0000FF"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock Name="LegendMinText" Text="0" Foreground="#CCCCCC" FontSize="9" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Легенда Серий (для сравнения из истории) -->
        <StackPanel Name="SeriesLegendPanel" Grid.Column="1" IsVisible="False" Margin="8,4" Spacing="4"
                    VerticalAlignment="Top">
            <TextBlock Text="Сессии" Foreground="#D4D4D4" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <ItemsControl Name="SeriesLegendItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">

                            <!-- Кнопка-глазик -->
                            <ToggleButton IsChecked="{Binding IsVisible}"
                                          Content="👁"
                                          Width="28" Height="28" Padding="0"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          Foreground="#CCCCCC"
                                          FontSize="12"
                                          Cursor="Hand"
                                          Click="LegendEyeButton_Click"/>
                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" Foreground="#D4D4D4" FontSize="11"
                                       VerticalAlignment="Center" MaxWidth="100" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
